# =============================================================================
# Application Configuration
# =============================================================================
APP_NAME=OAuth2 Server
APP_VERSION=1.0.0
DEBUG=false

# =============================================================================
# Security Configuration
# =============================================================================
SECRET_KEY=secret
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# =============================================================================
# Database Configuration
# =============================================================================
DATABASE_URL=postgresql://uauth:84QUE5d2pGhmkJfE6DGL@10.194.203.138:15432/db_auth
DATABASE_POOL_SIZE=0
DATABASE_MAX_OVERFLOW=0
DATABASE_ECHO=false
DATABASE_ECHO_POOL=false
DATABASE_POOL_PRE_PING=true
DATABASE_POOL_RECYCLE=3600
DATABASE_CONNECT_TIMEOUT=30
# DATABASE_COMMAND_TIMEOUT=

# SSL Configuration (optional)
# DATABASE_SSL_MODE=
# DATABASE_SSL_CERT=
# DATABASE_SSL_KEY=
# DATABASE_SSL_CA=

# =============================================================================
# Redis Configuration
# =============================================================================
REDIS_URL=
REDIS_MAX_CONNECTIONS=
REDIS_ENCODING=utf-8
REDIS_DECODE_RESPONSES=true
REDIS_SOCKET_CONNECT_TIMEOUT=5
REDIS_SOCKET_TIMEOUT=5
REDIS_HEALTH_CHECK_INTERVAL=30
REDIS_RETRY_ON_TIMEOUT=true

# Redis SSL Configuration (optional)
REDIS_SSL=false
# REDIS_SSL_CERT_REQS=
# REDIS_SSL_CA_CERTS=
# REDIS_SSL_CERTFILE=
# REDIS_SSL_KEYFILE=

# Redis Serialization
REDIS_SERIALIZER=json
REDIS_COMPRESS=false

# =============================================================================
# Server Configuration
# =============================================================================
SERVER_HOST=0.0.0.0
SERVER_PORT=8283
SERVER_RELOAD=false

# =============================================================================
# CORS Configuration
# =============================================================================
CORS_ORIGINS=["*"]
CORS_ALLOW_CREDENTIALS=true
CORS_ALLOW_METHODS=["*"]
CORS_ALLOW_HEADERS=["*"]

# =============================================================================
# Storage Configuration
# =============================================================================
STORAGE_BACKEND=minio
STORAGE_BUCKET_NAME=user-docs
STORAGE_ENDPOINT=minio.example.com:9000
STORAGE_ACCESS_KEY=YOUR_ACCESS_KEY
STORAGE_SECRET_KEY=YOUR_SECRET_KEY
STORAGE_SECURE=false
# STORAGE_REGION=
STORAGE_MAX_WORKERS=10
